# Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model chính dùng để dịch (mặc định nếu không set)
# Gợi ý: anthropic/claude-sonnet-4.5 (cân bằng), anthropic/claude-opus-4.1 (kỹ nhất),
#        google/gemini-2.5-pro (rẻ, context lớn), deepseek/deepseek-chat (rẻ nhất)
OR_MODEL=~deepseek/deepseek-v4-flash-latest

# Model cho việc nhẹ: căn chỉnh lại text bóc từ PDF ở bước 1. Đây là chuẩn hoá
# chuỗi, không cần model mạnh — và mọi thay đổi đều bị chốt chặn kiểm tra lại.
# Giá cho một bài ~17 trang (đo qua OpenRouter):
#   qwen/qwen3.7-flash    $0.010  · context 1M, rẻ và mới  <- khuyến nghị
#   mistralai/mistral-nemo $0.003 · rẻ nhất, model nhỏ
#   openai/gpt-oss-120b   $0.012  · chắc tay hơn, context 131k
#   ~deepseek/deepseek-v4-flash-latest $0.016 · giống model dịch mặc định
OR_MODEL_FAST=qwen/qwen3.7-flash

# Tên app hiển thị trên bảng xếp hạng OpenRouter (tuỳ chọn)
OR_APP_TITLE="Paper Reader VI"
OR_APP_URL=http://localhost:8010


# ---------------------------------------------------------------------------
# KHO SURVEY (cơ chế thứ hai: nhiều bài, tìm kiếm, hỏi đáp có trích dẫn)
# Không set gì cả thì vẫn chạy — mọi mục dưới đây đều có mặc định.
# ---------------------------------------------------------------------------

# Model tổng hợp câu trả lời cuối. Chỉ dùng ở ĐÚNG MỘT bước, vì hỏng khâu tổng
# hợp chiếm phần lớn số câu sai. Trống → dùng OR_MODEL.
SURVEY_MODEL=

# Model cho mọi bước còn lại: ngữ cảnh hoá, bóc phiếu, dựng cây, đồ thị, lập kế
# hoạch tìm, chấm lại kết quả, đọc đoạn. Trống → dùng OR_MODEL_FAST.
SURVEY_FAST_MODEL=

# Trần chi phí mặc định cho MỘT câu hỏi (USD). Kiểm trước mỗi lần gọi model.
SURVEY_BUDGET=0.50

# Tìm kiếm ngữ nghĩa chạy ngay trên máy: không key, không tiền, không giới hạn.
#   auto — tải model lần đầu dùng (~2,3GB), chạy GPU nếu có, không thì CPU
#   off  — tắt hẳn, bộ tìm rơi về BM25 đơn thuần (vẫn chạy, chỉ kém hơn)
# BGE-M3 được chọn vì kho là bài tiếng Anh còn câu hỏi là tiếng Việt: nó đặt cả
# hai thứ tiếng vào cùng một không gian vector.
EMBED_BACKEND=auto
SURVEY_EMBED_MODEL=BAAI/bge-m3

# Chấm lại kết quả bằng cross-encoder — bước cải thiện mạnh nhất trong cả chuỗi
# tìm kiếm. auto | off. Tắt thì chỉ còn tầng chấm bằng model.
RERANK_BACKEND=auto
SURVEY_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# arXiv, OpenAlex và Crossref KHÔNG cần key. Điền email thì hai nguồn sau xếp
# bạn vào hàng đợi ưu tiên (nhanh hơn lúc đông), không điền vẫn chạy.
SURVEY_CONTACT_EMAIL=

# Chỉ cần khi muốn thêm nguồn web thường ngoài giới học thuật.
# SEARCH_PROVIDER: brave | tavily | serper
SEARCH_API_KEY=
SEARCH_PROVIDER=brave


# Docker: chạy container bằng đúng uid/gid của bạn, nếu không nó không ghi được
# vào thư mục data/ trên máy chủ. Lấy bằng: id -u  và  id -g
DOCKER_UID=1000
DOCKER_GID=1000
